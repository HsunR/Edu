FROM maven:3.9.11-eclipse-temurin-21 AS builder
WORKDIR /build
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests package

FROM eclipse-temurin:21-jre AS gateway
WORKDIR /app
COPY --from=builder /build/Intelli-Edu-gateway/target/Intelli-Edu-gateway-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8890
ENTRYPOINT ["java", "-jar", "app.jar", "--spring.profiles.active=dev"]

FROM eclipse-temurin:21-jre AS user
WORKDIR /app
COPY --from=builder /build/Intelli-Edu-user/target/Intelli-Edu-user-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8891
ENTRYPOINT ["java", "-jar", "app.jar", "--spring.profiles.active=dev"]

