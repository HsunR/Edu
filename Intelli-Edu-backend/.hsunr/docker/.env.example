# 可选远程服务。保留默认值时，核心服务可以启动，但对应云功能不可用。
MAIL_USERNAME=local@example.invalid
MAIL_PASSWORD=local-disabled

TENCENT_CLOUD_SECRET_ID=local-disabled
TENCENT_CLOUD_SECRET_KEY=local-disabled
TENCENT_SMS_APP_ID=0
TENCENT_SMS_SIGN_NAME=local-disabled
TENCENT_SMS_TEMPLATE_ID=0

# 本地 MinIO。修改账号或桶名时，Compose 与 resource 服务会使用同一组值。
MINIO_ROOT_USER=intelli-edu
MINIO_ROOT_PASSWORD=intelli-edu-dev
MINIO_BUCKET=intelli-edu-resources
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_READ=true
MINIO_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
