<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gpnu.ai.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.gpnu.ai.model.entity.ChatMessage">
