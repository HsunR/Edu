<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gpnu.exam.paper.mapper.PaperQuestionMapper">
    <resultMap id="BaseResultMap" type="com.gpnu.exam.paper.model.entity.PaperQuestion">
        <id property="id" column="id"/>
        <result property="paperId" column="paper_id"/>
        <result property="questionId" column="question_id"/>
        <result property="orderIndex" column="order_index"/>
        <result property="score" column="score"/>
        <result property="sectionIndex" column="section_index"/>
        <result property="questionSnapshot" column="question_snapshot" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, paper_id, question_id, order_index, score,
        section_index, question_snapshot, is_deleted
    </sql>
</mapper>
